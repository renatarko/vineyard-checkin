# Projeto Supabase. Copie para .env.local e preencha.
VITE_SUPABASE_URL=""              # https://<ref>.supabase.co  (local: http://127.0.0.1:54321)
VITE_SUPABASE_PUBLISHABLE_KEY=""  # anon / publishable key
VITE_SUPABASE_PROJECT_ID=""       # <ref>

# A service role key NUNCA entra aqui. Ela vive como secret das Edge Functions:
#   supabase secrets set DOMINIO_CONVITES=vineyard-checkin.rerko.net
# e o CLI injeta SUPABASE_SERVICE_ROLE_KEY sozinho no `supabase functions serve`.

# Modo demonstração: as telas rodam com dados falsos, em memória, sem Supabase.
# Use para trabalhar no layout sem subir banco (ou rode `npm run dev:mock`).
# VITE_MOCK=true
